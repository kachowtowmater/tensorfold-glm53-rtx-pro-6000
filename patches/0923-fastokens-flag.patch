# 0923 fastokens prompt encoding behind TF_W1_FASTOKENS=1 (x14). Applies after 0921 (uses App._encode_ids).
# fastokens 0.3.2 (github.com/crusoecloud/fastokens c1e193ea, Apache-2.0, PyPI wheel in IMAGE_EXTRAS); idea from
# local-inference-lab vllm #934 / blackwell-llm-docker #112 (VLLM_USE_FASTOKENS). New tensorfold/cuda/fasttok.py; server.py
# App._encode_ids, the IncrementalTokenizer tail (literal barriers from the text, HF-offsets fallback on any disagreement)
# and vision/glm.py use it. Off (TF_W1_FASTOKENS=0) = x9 + 0921 exactly.

diff --git tensorfold/cuda/fasttok.py tensorfold/cuda/fasttok.py
new file mode 100644
index 0000000..73bc8ee
--- /dev/null
+++ tensorfold/cuda/fasttok.py
@@ -0,0 +1,46 @@
+"""patch 0923 (x14): fastokens-backed prompt encoding, enabled only by TF_W1_FASTOKENS=1.
+
+fastokens (github.com/crusoecloud/fastokens, pinned 0.3.2 in the image) re-implements the tokenizer.json BPE
+pipeline in Rust. Its ``encode_batch_flat`` tokenizes with Python's GIL released and splits one long input across
+worker threads (FASTOKENS_BPE_THREADS, default min(cores, 32)); a 300k-token prompt is ~27 ms vs ~450 ms in HF
+tokenizers (rtx6kpro daily 2026-09-30, LIL vllm #934). It returns ids only (no character offsets), so it serves the
+id-only call sites; the incremental tokenizer derives its literal barriers from the text itself and falls back to HF
+tokenizers whenever the two disagree. Decoding, chat templates and every other tokenizer use stay on HF tokenizers.
+Off (TF_W1_FASTOKENS=0, the default) the server is byte-for-byte the x9 + 0921 behaviour.
+"""
+from __future__ import annotations
+
+import os
+import sys
+from array import array
+
+
+def enabled() -> bool:
+    value = os.environ.get("TF_W1_FASTOKENS", "0")
+    if value not in ("0", "1"):
+        raise ValueError("TF_W1_FASTOKENS must be 0 or 1")
+    return value == "1"
+
+
+class FastEncoder:
+    """``ids(text, special)`` == ``tokenizers.Tokenizer.encode(text, add_special_tokens=special).ids`` (checked by the
+    x14 identity gate over the 400k corpus, the needle corpus and varied texts), computed without holding the GIL."""
+
+    def __init__(self, path) -> None:
+        from fastokens._native import Tokenizer
+
+        if sys.byteorder != "little" or array("I").itemsize != 4:
+            raise RuntimeError("fastokens flat ids are little-endian uint32")
+        self.tok = Tokenizer.from_file(str(path))
+
+    def ids(self, text: str, special: bool = False) -> list[int]:
+        buf, _ = self.tok.encode_batch_flat([text], add_special_tokens=special)
+        out = array("I")
+        out.frombytes(buf)
+        return out.tolist()
+
+
+def load(path):
+    """A FastEncoder for ``path`` when TF_W1_FASTOKENS=1, else None (the HF tokenizers path)."""
+
+    return FastEncoder(path) if enabled() else None
