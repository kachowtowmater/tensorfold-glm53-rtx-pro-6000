+def vision_prefix(value: str | None = None) -> bool:
+    """TF_GLM_VISION_PREFIX=1: an image prompt resumes its kept text prefix too, capped at its first image row
+    (patch 0910). Off (the default), a request carrying images never resumes and reports cache_reason "vision"; on,
+    the longest kept prefix strictly shorter than the first image position (``positions[0]``) is adopted and the rows
+    from there, image ones included, prefill as before."""
+
+    value = (os.environ.get("TF_GLM_VISION_PREFIX", "") if value is None else value).strip().lower()
+    if value in ("", "0", "off"):
+        return False
+    if value in ("1", "on", "true"):
+        return True
+    raise ValueError(f"TF_GLM_VISION_PREFIX: 0 (off) or 1 (on), not {value!r}")
+
