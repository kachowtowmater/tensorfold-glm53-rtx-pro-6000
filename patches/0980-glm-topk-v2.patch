new file mode 100644
--- /dev/null
+++ src/tensorfold/families/glm5_next/cuda/topk_v2.cpp
@@ -0,0 +1,28 @@
+// Bindings of topk_v2.cu (TF_GLM_TOPK_V2=1, patch 0980): the segmented decode selection (sparse.seg_select_tokens'
+// split path) by one kernel launch — SGLang's DeepSeek-v4 topk_v2 single-block radix select ported to the recipe's
+// order-key selection. sparse.py's hook calls topk_v2.seg_select; the extension is built by topk_v2._ext().
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void seg_select_cuda(const at::Tensor& scores, int64_t s_stride, const at::Tensor& pos, const at::Tensor& sparse,
+                     const at::Tensor& tok, const at::Tensor& cnt, int64_t np_max);
+
+// scores [R, NP] fp32 (contiguous rows, NP the scratch's pools), pos/sparse the SegRows tables ([R] int32 each),
+// tok [R, 2051] int32 (its sentinel -1 pre-staged; dense rows' tokens untouched), cnt [R] int32 (dense rows 0).
+void seg_select(const at::Tensor& scores, int64_t s_stride, const at::Tensor& pos, const at::Tensor& sparse,
+                const at::Tensor& tok, const at::Tensor& cnt, int64_t np_max) {
+    TORCH_CHECK(scores.is_cuda() && scores.scalar_type() == at::kFloat && scores.dim() == 2 && scores.is_contiguous(),
+                "topk_v2: contiguous fp32 scores [R, NP]");
+    TORCH_CHECK(scores.size(1) >= 512 && scores.size(1) <= (1LL << 20), "topk_v2: rows of 512 to 2^20 pools");
+    TORCH_CHECK(pos.is_cuda() && pos.scalar_type() == at::kInt && sparse.is_cuda() && sparse.scalar_type() == at::kInt,
+                "topk_v2: int32 SegRows pos and sparse");
+    TORCH_CHECK(tok.is_cuda() && tok.scalar_type() == at::kInt && tok.size(1) == 512 * 4 + 3 && tok.is_contiguous(),
+                "topk_v2: tok [R, 2051] int32 contiguous");
+    TORCH_CHECK(cnt.is_cuda() && cnt.scalar_type() == at::kInt && cnt.is_contiguous(), "topk_v2: cnt [R] int32");
+    TORCH_CHECK(np_max == scores.size(1) && s_stride == scores.stride(0), "topk_v2: np_max and s_stride of scores");
+    seg_select_cuda(scores, s_stride, pos, sparse, tok, cnt, np_max);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("seg_select", &seg_select);
+}
