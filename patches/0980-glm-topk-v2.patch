+"""TF_GLM_TOPK_V2=1 (patch 0980): the segmented decode selection (``sparse.seg_select_tokens``'s split path,
+``select_split``'s five launches) by one CUDA kernel launch (``topk_v2.cu``), SGLang's DeepSeek-v4 topk_v2 kernel
+(sgl_kernel/deepseek_v4/topk_impl.cuh: the single-block radix select) ported to the order-key selection the recipe
+already uses.
+
+The contract is sparse.select_split's SEG path exactly, a function of the scores and the SegRows tables alone:
+- each sparse row (``sparse[r] != 0``) attends its ``npool = (pos[r] + 1) // 4`` visible pools; scores past them are
+  -inf with the highest indices (``_seg_scores`` writes only visible columns), and the columns a window's power-of-two
+  bucket scores past them rank below every kept pool, so the K = 512 best of the visible pools are the K best of the
+  row (the same argument _visible_bound makes);
+- selection by uint32 order keys (_order_key: -0 counted as +0), ties to the lower pool, output in ascending pool
+  order: _select_rows' semantics, held by select_split;
+- tokens: the K pools' 4 tokens each ascending, then the incomplete pool's visible tokens (npool * 4 .. pos), the
+  rest -1; counts: K * 4 + visible tail for npool > K, else 0; dense rows get count 0 and untouched tokens
+  (select_split writes only their count);
+- rows without segments behind them (``pos`` < SPARSE_FROM) are dense by ``sparse`` and never reach the kernel's
+  selection (the same tables the Triton path reads).
+
+The kernel is SGLang's coarse 12-bit histogram pass + threshold + fp32 tie handling + exact radix tie select (their
+device::topk impl, 1024 threads, one block a row), with their per-element emit replaced by the pool-to-token write.
+No clusters, no page table, no plan: a decode window holds at most a few hundred rows, one block each fills the GPU,
+and the selection is a function of the row alone. Default off: TF_GLM_TOPK_V2 unset or 0 keeps x23 exactly (P2: the
+flag routes and nothing else changes); '1' routes seg_select_tokens through seg_select below.
+self_check(device) compares the kernel with select_split byte for byte on synthetic windows covering ties, signed
+zeros, NaN/inf and ragged lengths (a test helper; the routing never calls it, so CUDA graph capture stays clean).
+TF_GLM_TOPK_V2_CHECK=1 compares every call (a test setting; it allocates, so not under graph capture).
+
+Licensed under the Apache License, Version 2.0. Builds on TensorFold (Ash Hart and the TensorFold contributors) and on
+the GLM-5.3-Flash recipe and patches 0001-0056 by MiaAI-Lab; the kernel is a port of sglang's
+sgl-kernel deepseek_v4 topk_v2.cuh (Apache-2.0, SGLang project)."""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from .sparse import POOL, SPARSE_FROM, TOKENS, TOPK_POOLS
+
+K = TOPK_POOLS
+
+_EXT = None
+
+
+def _flag() -> bool:
+    """TF_GLM_TOPK_V2: 1 routes the decode selection through seg_select; unset, '' or 0 the x23 path."""
+    value = (os.environ.get("TF_GLM_TOPK_V2", "") or "0").strip()
+    if value not in ("0", "1"):
+        raise ValueError(f"TF_GLM_TOPK_V2: 0 or 1, not {value!r}")
+    return value == "1"
+
+
+def _check_flag() -> bool:
+    value = (os.environ.get("TF_GLM_TOPK_V2_CHECK", "") or "0").strip()
+    if value not in ("0", "1"):
+        raise ValueError(f"TF_GLM_TOPK_V2_CHECK: 0 or 1, not {value!r}")
+    return value == "1"
+
+
+def on() -> bool:
+    return _flag()
+
+
+def _ext():
+    global _EXT
+    if _EXT is None:
+        from functools import lru_cache
+        from pathlib import Path
+
+        from tensorfold.cuda.build import load
+
+        here = Path(__file__).parent
+
+        @lru_cache(maxsize=1)
+        def build():
+            return load(name="tensorfold_glm_topk_v2_v1",
+                        sources=[str(here / "topk_v2.cu"), str(here / "topk_v2.cpp")],
+                        extra_cuda_cflags=["-O3"], verbose=False)
+
+        _EXT = build
+    return _EXT()
+
+
+def applies(scores: torch.Tensor) -> bool:
+    """The kernel's shapes: contiguous fp32 [R, NP] rows on the GPU, NP from K to 2^20 (any alignment)."""
+    return (scores.is_cuda and scores.dtype == torch.float32 and scores.dim() == 2 and scores.is_contiguous()
+            and K <= scores.shape[1] <= 1 << 20)
+
+
+_FELL_BACK: set = set()
+
+
+def seg_select(scores: torch.Tensor, k: int, *, rows, tokens, counts) -> None:
+    """select_split's SEG contract by the kernel: ``rows`` (segments.SegRows), ``tokens`` [R, TOKENS] and
+    ``counts`` [R] int32 written in place. A shape the kernel does not take falls back to select_split with one
+    line a kind of shape; it never raises on a shape."""
+    R, NP = scores.shape
+    if not applies(scores) or k != K or tokens.shape[0] < R or tokens.shape[1] != TOKENS or counts.shape[0] < R \
+            or not tokens.is_contiguous() or not counts.is_contiguous() or not scores.device == rows.pos.device:
+        why = (str(scores.device.type), str(scores.dtype), scores.dim(), bool(scores.is_contiguous()), k, R, NP,
+               tuple(tokens.shape), bool(tokens.is_contiguous()))
+        if why not in _FELL_BACK:
+            _FELL_BACK.add(why)
+            print(f"[tensorfold] topk_v2: scores {tuple(scores.shape)} k {k} tokens {tuple(tokens.shape)}: not the "
+                  "kernel's shape, select_split runs", flush=True)
+        from . import sparse
+
+        sparse.select_split(scores, k, rows=rows, tokens=tokens, counts=counts)
+        return
+    _ext().seg_select(scores, scores.stride(0), rows.pos, rows.sparse, tokens, counts, NP)
+    if _check_flag():
+        t0 = tokens.clone()
+        c0 = counts.clone()
+        reference(scores, k, rows=rows, tokens=t0, counts=c0)
+        if not torch.equal(tokens, t0) or not torch.equal(counts, c0):
+            raise RuntimeError("TF_GLM_TOPK_V2_CHECK: the kernel's tokens or counts differ from select_split's")
+
+
+def reference(scores: torch.Tensor, k: int, *, rows, tokens, counts) -> None:
+    """select_split on the same inputs (the comparison's right side)."""
+    from . import sparse
+
+    sparse.select_split(scores, k, rows=rows, tokens=tokens, counts=counts)
+
+
+def self_check(device) -> bool:
+    """The kernel against select_split on synthetic windows: rows of every kind (ties, signed zeros, NaN/inf,
+    ragged lengths, dense rows), byte for byte."""
+    from . import segments as segm
+    from . import sparse
+
+    gen = torch.Generator(device=device).manual_seed(980)
+    lens = (512, 513, 4096, 8192, 16385, 65536, 262144)
+    kinds = ("randn", "all_equal", "pm_zero", "tie4096", "bf16_ties", "nan_inf", "neg_inf_head")
+    for R in (1, 3, 16, 64):
+        for seed in range(2):
+            spans, pos, rs = [], [], []
+            base = 0
+            for i in range(R):
+                L = lens[(i + seed) % len(lens)]
+                kind = kinds[(i + 2 * seed) % len(kinds)]
+                q = 4 * L - 1 + (i + seed) % 4
+                pos.append(q)
+                spans.append((base, q, 1))
+                base += (-(-(q + 1) // segm.EXTENT) + 1) * segm.EXTENT
+                if kind == "randn":
+                    s = torch.randn(L, device=device, generator=gen)
+                elif kind == "all_equal":
+                    s = torch.full((L,), 1.5, device=device)
+                elif kind == "pm_zero":
+                    s = torch.zeros(L, device=device)
+                    s[torch.randperm(L, device=device, generator=gen)[: L // 2]] = -0.0
+                    s[torch.randperm(L, device=device, generator=gen)[: min(100, L // 8)]] = 2.0
+                elif kind == "tie4096":
+                    s = torch.rand(L, device=device, generator=gen) - 1.5
+                    idx = torch.randperm(L, device=device, generator=gen)
+                    s[idx[: min(300, L // 4)]] = 5.0
+                    s[idx[min(300, L // 4): min(300, L // 4) + min(4096, L - L // 4)]] = 1.0
+                elif kind == "bf16_ties":
+                    s = (torch.randn(L, device=device, generator=gen) * 0.05).to(torch.bfloat16).float()
+                elif kind == "nan_inf":
+                    s = torch.randn(L, device=device, generator=gen)
+                    j = torch.randperm(L, device=device, generator=gen)[:8]
+                    s[j[0]], s[j[1]], s[j[2]], s[j[3]] = float("nan"), -float("nan"), float("inf"), -float("inf")
+                    s[j[4]] = -0.0
+                else:
+                    s = torch.randn(L, device=device, generator=gen)
+                    s[: L // 4] = float("-inf")                     # -inf-heavy: the bucket's dead columns
+                rs.append(s)
+            rows = segm.SegRows(R, device, max_segs=max(segm.MAX_SEGS, R))
+            rows.set(spans)
+            sel = segm.SelectScratch(R, max(4 * max(lens), 32768), device)
+            sel.scores[:, : max(4 * max(lens), 32768)] = 0.0
+            for r, s in enumerate(rs):
+                sel.scores[r, :s.numel()] = s
+                sel.scores[r, s.numel():] = float("-inf")
+            NP = sel.scores.shape[1]
+            scores = sel.scores[:R, :NP]
+            t1 = torch.full((R, TOKENS), -1, dtype=torch.int32, device=device)
+            c1 = torch.full((R,), -7, dtype=torch.int32, device=device)
+            seg_select(scores, K, rows=rows, tokens=t1, counts=c1)
+            t0 = torch.full((R, TOKENS), -1, dtype=torch.int32, device=device)
+            c0 = torch.full((R,), -7, dtype=torch.int32, device=device)
+            sparse.select_split(scores, K, rows=rows, tokens=t0, counts=c0)
+            if not torch.equal(t1, t0) or not torch.equal(c1, c0):
+                return False
+    return True
+
+
+_DECIDED: bool | None = None
+
+
+def checked(device) -> bool:
+    """The setting, and its check passed on this GPU (the first call of the process compares once)."""
+    global _DECIDED
+    if not _flag():
+        return False
+    if _DECIDED is None:
+        try:
+            ok = self_check(device)
+            why = "" if ok else ": its tokens differ from select_split's on this GPU"
+        except Exception as exc:  # noqa: BLE001 - a kernel that cannot run here is off; select_split runs
+            ok, why = False, f": {type(exc).__name__}: {str(exc).splitlines()[0][:160] if str(exc) else ''}"
+        _DECIDED = ok
+        print(f"[tensorfold] topk_v2 decode selection: {'on (checked against select_split)' if ok else 'off' + why}",
+              flush=True)
+    return _DECIDED
