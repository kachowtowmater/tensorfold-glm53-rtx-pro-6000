+class _Extent:
+    """One reservation of the park staging pool: ``.map`` is the reserved slice of the pool's memory as
+    a writable uint8 numpy view (a view of ``HostBuffer.array``: whatever that supports, this supports), ``tensor``
+    the same bytes as a flat uint8 tensor over the pinned HostBuffer (a D2H ``copy_`` lands in the extent),
+    ``off``/``nbytes`` identify it for the pool. One owner at a time (round 3): ``released`` flips on
+    ``_ParkPool.release`` and a second release raises instead of corrupting the free list."""
+
+    __slots__ = ("map", "nbytes", "off", "tensor", "released")
+
+    def __init__(self, pool_arr: np.ndarray, off: int, nbytes: int) -> None:
+        self.map, self.nbytes, self.off = pool_arr[off:off + nbytes], nbytes, off
+        self.tensor = torch.from_numpy(pool_arr[off:off + nbytes])
+        self.released = False
+
+    def __len__(self) -> int:
+        return self.nbytes
+
+
+class _ParkPool:
+    """One preallocated pinned staging buffer (TF_GLM_PARK_STAGING_GIB per rank) and a first-fit extent
+    allocator over it: park reserves one extent of the file's size, copies the sections into it (no new host
+    allocation on the caller), the Writer checksums, headers and writes it out, then the extent goes back to the
+    free list. Full pool: park drops the state at once (back-pressure)."""
+
+    def __init__(self, nbytes: int, pin: bool) -> None:
+        self.hb = HostBuffer(max(int(nbytes), PAGE), pin)
+        self.free = [(0, self.hb.nbytes)]
+
+    def reserve(self, n: int) -> _Extent | None:
+        """First fit over the free list (coalesced on release): pure bookkeeping, no allocation."""
+
+        n = round_up(n)
+        for i, (off, size) in enumerate(self.free):
+            if size >= n:
+                self.free[i] = (off + n, size - n) if size - n else None
+                if self.free[i] is None:
+                    del self.free[i]
+                return _Extent(self.hb.array, off, n)
+        return None
+
+    def release(self, ext: "_Extent") -> None:
+        """Return an owned extent to the free list, coalescing with the neighbours. One owner at a time (round 3):
+        a second release raises ``ValueError`` instead of handing the same bytes out twice."""
+
+        if ext.released:
+            raise ValueError("a park staging extent was released twice")
+        ext.released = True
+        merged: list[tuple[int, int]] = []
+        for o, s in sorted(self.free + [(ext.off, ext.nbytes)]):
+            if merged and o <= merged[-1][0] + merged[-1][1]:
+                merged[-1] = (merged[-1][0], max(merged[-1][1], o + s - merged[-1][0]))
+            else:
+                merged.append((o, s))
+        self.free = merged
+
+    def close(self) -> None:
+        self.hb.close()
+
