+def _check_image(image, expect: dict) -> dict:
+    """A pending image's header, validated the way ``read_header`` does (from host memory, no disk read):
+    magic, version, the JSON's checksum, the sections inside the image, ``check_header``."""
+
+    buf = memoryview(image.map)
+    if len(buf) < PAGE or len(buf) % PAGE:
+        raise PCacheError(f"truncated ({len(buf)} bytes)")
+    magic, version, jlen, start, jsum = PREFIX.unpack(bytes(buf[:PREFIX.size]))
+    if magic != MAGIC:
+        raise PCacheError("not a prompt state file")
+    if version != VERSION:
+        raise PCacheError(f"format version {version}, not {VERSION}")
+    if start % PAGE or start < PREFIX.size + jlen or start > len(buf):
+        raise PCacheError("a bad header length")
+    raw = bytes(buf[PREFIX.size:PREFIX.size + jlen])
+    try:
+        algo = json.loads(raw).get("sum", SUM)
+    except ValueError:
+        raise PCacheError("a corrupt header") from None
+    if checksum(raw, algo) != jsum:
+        raise PCacheError("a corrupt header")
+    meta = dict(json.loads(raw), data_start=start, file_bytes=len(buf))
+    end = 0
+    for s in meta.get("sections", []):
+        if s["offset"] % PAGE or s["nbytes"] < 0:
+            raise PCacheError("a misplaced section")
+        end = max(end, s["offset"] + round_up(s["nbytes"]))
+    if start + end > len(buf):
+        raise PCacheError(f"truncated ({len(buf)} bytes, the header asks {start + end})")
+    check_header(meta, expect)
+    return meta
+
