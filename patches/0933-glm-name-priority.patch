 import argparse
 import inspect
+import os
+from pathlib import Path
 from typing import Any
 
 
+def name_priority(args: Any) -> dict[str, str]:
+    """--name-priority entries ("id=class", repeated) as {id: class}; ValueError for a malformed one."""
+
+    out: dict[str, str] = {}
+    for entry in getattr(args, "name_priority", None) or ():
+        text = str(entry).strip()
+        ident, sep, klass = text.partition("=")
+        if not sep or not ident.strip() or not klass.strip():
+            raise ValueError(f"--name-priority: model id = priority class (background, for instance), not {text!r}")
+        out[ident.strip()] = klass.strip()
+    return out
+
+
+def _name_priority_env() -> dict[str, str]:
+    """TENSORFOLD_NAME_PRIORITY (patch 0933, default "": off) as {id: class}: comma- or space-separated
+    "id=class" pairs, so the fleet's serve scripts can set a background alias without a code change."""
+
+    raw = os.environ.get("TENSORFOLD_NAME_PRIORITY", "")
+    if not raw.strip():
+        return {}
+
+    class _Args:
+        name_priority = [part for part in raw.replace(",", " ").split() if part]
+
+    return name_priority(_Args())
+
+
 def check(args: argparse.Namespace, family: Any, backend: str, config_dir: Any = None) -> None:
     """Refuse KV cache, draft rule, image, share, slot and precision options the backend or family can't serve."""
 
