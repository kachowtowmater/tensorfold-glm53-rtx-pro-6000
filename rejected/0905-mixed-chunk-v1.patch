+        self.grouped["pieces"] += len(group)
+        self.grouped["rows"] += rows
+        prof = self.profiles[False] if self.profiles is not None else None
+        if prof is not None:
+            prof.fill(time.perf_counter() - t)
+        return [l.s for l, _ in group if l.s.done]
