+def mixed_chunk(value: str | None = None) -> bool:
+    """TF_GLM_MIXED_CHUNK (patch 0905, default 0): a prompt chunk's iteration carries a decode round with it —
+    one MFILLR message: the chunk's rows on the prompt buffers, then the round's verify window as today, back to
+    back in the same iteration (the round's kernels queue behind the chunk's on the stream). Off: every
+    iteration stays exactly one op, as before."""
+
