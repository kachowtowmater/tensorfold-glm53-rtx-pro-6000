+    def _mixed_fill_only(self, group: list[tuple[Lane, int]]) -> list[Stream]:
+        """The group chunk of a mixed iteration whose round found no room: the MFILL path verbatim."""
+
+        service_started = self._service_start()
+        t = time.perf_counter()
+        rows = sum(stop - l.st.pos for l, stop in group)
+        self._emit(MFILL, [len(group), *[v for l, stop in group for v in (l.sid, stop)]])
+        self._flush()
+        firsts = self._fill_many(group)
+        self._service_end(service_started, fill=True)
+        now = self.clock()
+        for (l, _), first in zip(group, firsts):
