+            for (l, _), first in zip(group, firsts):
+                l.since = now
+                if first is not None:
+                    l.s.take([first], self._ends(l))
+            self.grouped["chunks"] += 1
+            self.grouped["pieces"] += len(group)
+            self.grouped["rows"] += rows
+        else:
