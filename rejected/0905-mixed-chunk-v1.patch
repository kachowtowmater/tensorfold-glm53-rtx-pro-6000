+    def _mixed_iterate(self, lane: Lane, group: list[tuple[Lane, int]] | None) -> list[Stream]:
+        """Rank 0, patch 0905: ONE iteration = a prompt chunk (this ``lane``'s, or the MFILL ``group``) + the
+        decode round ``_mixed_turn`` planned, emitted as ONE MFILLR message, then applied back to back: the chunk's
+        forwards first, the round's verify window right after on the same stream (its kernels queue behind the
+        chunk's tail). Everything else behaves as the two separate paths do: the chunk's first token, the round's
+        drafts, depths, sample and commit, the arbiter's ``rounded``, the round gap's cycle."""
+
+        t = time.perf_counter()
