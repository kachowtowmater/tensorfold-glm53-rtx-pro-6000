+    def _mixed_turn(self, lane: Lane | None, group: list[tuple[Lane, int]] | None
+                    ) -> tuple[list[Lane], list[Lane], bool] | None:
+        """Rank 0, patch 0905 (TF_GLM_MIXED_CHUNK): the round a chunk's iteration carries, or None.
+
+        The chunk is already decided (``lane``, or ``group`` when TF_GLM_MULTI_PREFILL grouped more streams into
+        it); this plans the decode side exactly as the round-only path does — the same lanes, the same grow/pause
+        rules, ``_round_cap().take`` called the same way with the same ``full`` flag, the same heads rules — so
+        round_gap accounting (``priority.py``) stays honest. The arbiter is untouched: it gates whether the chunk
+        goes this iteration (it did), the attached round is free. A round whose every stream waits for room emits
+        nothing (its give-backs, if any, ride the message already in the outbox)."""
+
+        if lane is None:
+            return None
+        lanes = decoding = [l for l in self.lanes.values() if l.decoding and not l.s.done]
+        heads = self._heads(lanes)
+        if heads and self.full_at is None:
+            self.full_at = self.clock()
+        if heads and self.clock() - self.full_at >= self.prio.round_gap_s:
+            heads = []
+        for l in heads:
+            l.paused = not self._grow(l.extent, l.st.pos + self.rows_max, protect=[l.extent])
+        everyone = len(lanes)
+        if any(not l.paused for l in heads):
+            lanes = heads
+        for l in lanes:                       # room for this round's widest window, else paused
+            l.paused = not self._grow(l.extent, l.st.pos + self.rows_max, protect=[l.extent])
+        active = [l for l in lanes if not l.paused]
+        if active:
+            active = self._round_cap().take(active, decoding, full=len(lanes) == everyone)
+        if not active:
+            if lanes and not any(not l.decoding for l in self.lanes.values()):
