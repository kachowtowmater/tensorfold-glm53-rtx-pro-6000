0903-decode-wait-budget.patch: TensorFold v0.6.5 port.
Origin: this recipe's first in-house scheduling patch (tb default #1197).
Port: written against TF v0.6.5 + the 86-patch release series + 0900 + 0901 (the x2 tree);
single file: families/glm5_next/cuda/multi.py. See p1-design.md for the map.
--- tensorfold/families/glm5_next/cuda/multi.py
+++ tensorfold/families/glm5_next/cuda/multi.py
@@ -153,6 +153,28 @@
     return value
 
 
+def decode_wait_ms(value: str | None = None) -> int:
+    """TF_GLM_DECODE_WAIT_MS: when streams decode, a fill yields to a decode round after this many milliseconds
+    since the last one (0: off, the default). TF_GLM_DECODE_WAIT_MAX_ROUNDS: at most this many decode rounds in a
+    row come from the budget before a filling stream's chunk goes (fills cannot starve)."""
+
+    value = os.environ.get("TF_GLM_DECODE_WAIT_MS", "") if value is None else value
+    try:
+        ms = int(value.strip() or "0")
+    except ValueError:
+        ms = -1
+    if ms < 0:
+        raise ValueError(f"TF_GLM_DECODE_WAIT_MS: whole milliseconds >= 0 (0: off), not {value!r}")
+    return ms
+
+
+def decode_wait_max_rounds(value: str | None = None) -> int:
+    value = (os.environ.get("TF_GLM_DECODE_WAIT_MAX_ROUNDS", "2") if value is None else value).strip() or "2"
+    if not value.isdecimal() or not 1 <= int(value) <= 1000:
+        raise ValueError(f"TF_GLM_DECODE_WAIT_MAX_ROUNDS: 1 to 1000 rounds, not {value!r}")
+    return int(value)
+
+
